     def process_alive(pid: int) -> bool:
         if pid <= 0:
             return False
         try:
+            # kill(pid, 0) succeeds for zombies.  Treat /proc state Z as
+            # terminated so recovered jobs cannot remain leased forever.
+            stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
+            closing_paren = stat.rfind(")")
+            if closing_paren >= 0 and stat[closing_paren + 1 :].strip().startswith("Z"):
+                return False
             os.kill(pid, 0)
             return True
